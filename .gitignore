# ---- build artifacts ----
build/
dist/
# 并行构建目录（旧实例占用 dist/Jinghe.exe 时使用）
dist_v*/
__pycache__/
*.pyc
*.pyo

# ---- runtime outputs ----
out/
out-*/
*.log

# ---- misc ----
.DS_Store
*.bak
Thumbs.db

# ---- 本地验收产物（不随源码/安装包发布） ----
.edge-probe*/
ui/__probe*.html
v[0-9]*.png

# ---- Electron 外壳（v1.1.0+）----
# node_modules 与构建产物一律不入库，CI 用 npm ci 按 package-lock.json 还原
electron/node_modules/
electron/release/
# 后端 exe 由 CI 构建后COPY进来（见 ci.yml），不提交二进制
electron/backend/*.exe
